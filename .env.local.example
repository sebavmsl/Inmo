# Supabase — proyecto existente (mismo que usa la v1)
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo se usa server-side (Server Actions / Route Handlers).
# NUNCA prefijar con NEXT_PUBLIC_ ni exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Meta WhatsApp Business API — se completa en el Módulo 3/8
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Cron diario consolidado (Módulo 3 + 8) — protege /api/cron/motor-diario.
# Debe coincidir EXACTAMENTE con el secreto guardado en Supabase Vault
# (nombre 'cron_secret', ver migraciones 0004 y 0010). Generar con:
#   openssl rand -hex 32
CRON_SECRET=
